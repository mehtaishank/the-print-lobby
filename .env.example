# Copy this to .env.local and fill in real values.

# "development" shows OTP codes on screen; "production" disables dev helpers
APP_ENV=development

# Strong random string for signing cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Staff dashboard password
ADMIN_PASSWORD=change-me

# ---- Supabase ---------------------------------------------------------------
# Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon/public key (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key (Settings → API → service_role) — NEVER expose this to browser
SUPABASE_SERVICE_KEY=eyJ...

# Postgres connection string (Settings → Database → URI)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ---- WhatsApp / SMS OTP (add when ready) ------------------------------------
# WHATSAPP_API_KEY=
# WHATSAPP_PHONE_ID=

# ---- Razorpay (add when KYC done) -------------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
